# SpamShield AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Flask Backend Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
AUTH_ENFORCED=true
PORT=5000
HOST=127.0.0.1

# Database Configuration
# Default uses local SQLite in the database/ directory
DATABASE_URL=sqlite:///database/spamshield.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML / Detection Configuration
ML_MODEL_DIR=ml/models
ENABLE_HEURISTIC_FALLBACK=true

# Security Settings
MAX_CONTENT_LENGTH=5242880 # 5 MB max payload
RATELIMIT_DEFAULT=100 per minute
